
{
  "expo": {
    "name": "calorie-tracker",
    "slug": "calorie-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cal.png",
    "scheme": "calorietracker",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.calorietracker.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/calorie-tracker-logo.png",
        "backgroundImage": "./assets/images/calorie-tracker-logo.png",
        "monochromeImage": "./assets/images/calorie-tracker-logo.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
"plugins": [
  "expo-sqlite",
  "expo-font"
]  }
}
